 template:dolphin/service-level:L1\\\\n      metadata:labels:dolphin/service-level:L1\\\\n        dolphin/service-level:L1 spec:template:metadata.\\\\n          dolphin/service-level:L1\\\\n      spec:dolphin/service-level:L1\\\\n        containers:name:node-cache\\\\n        - name:node-cache\\\\n          resources:dolphin/service-level:L1 spec:containers:name:node-cache\\\\n            cpu:400m\\\\n              cpu:400m\\\\n              memory:368Mi\\\\n            requests.\\\\n              cpu:100m\\\\n              memory:128Mi\\\\n\\\\n  1.1.0\\\\n  1. Packaging image\\\\n  Package image k8s-dns-node-cache:1.17.0.2\\\\n  2, localdns configmap configuration cancellation force_tcp\\\\n  3, coredns disassemble the independent patch package\\\\n\\\\n## Update impact\\\\n  cluster\\\\n\\\",\\\"download-url\\\":\\\"https://oa.kedacom.com/confluence/display/ctsp/pc26003-V1.1.0\\\",\\\"index\\\":\\\"1203\\\",\\\"iomp-version\\\":\\\"2.6\\\",\\\"name\\\":\\\"pc26003\\\",\\\"package-type\\\":\\\"patch\\\",\\\"patch_id\\\":\\\"pc26003\\\",\\\"patch_version\\\":\\\"1.1.0\\\",\\\"pre-version\\\":\\\"2.6.*\\\",\\\"priority\\\":\\\"option\\\",\\\"range\\\":\\\"cluster\\\",\\\"release-time\\\":\\\"2024-02-23\\\",\\\"script-type\\\":\\\"normal\\\",\\\"severity\\\":\\\"serious\\\",\\\"type\\\":\\\"cluster\\\"},\\\"kind\\\":\\\"ConfigMap\\\",\\\"metadata\\\":{\\\"annotations\\\":{},\\\"labels\\\":{\\\"dolphin/kind\\\":\\\"patch-pack\\\",\\\"severity\\\":\\\"deadly\\\"},\\\"name\\\":\\\"dol-pc26003\\\",\\\"namespace\\\":\\\"default\\\"}}\\n\"},\"clusterGateway\":null,\"clusterId\":\"02b01cdf6b534d80a67d8b1994870547\",\"clusterIp\":null,\"commands\":null,\"completions\":null,\"concurrencyPolicy\":null,\"conditions\":null,\"containerIds\":null,\"containerIp\":null,\"containerStatus\":null,\"containersVos\":null,\"createTime\":\"2026-02-03 14:41:32\",\"download\":\"enabled\",\"envVars\":null,\"envs\":null,\"events\":null,\"externalIps\":null,\"grafanaUrl\":null,\"images\":null,\