{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utm-simulator/schemas/route_schema.json",
  "title": "UTM Flight Route Schema",
  "description": "Redis BIZ_DATA:UAV_ROUTE hash value schema — single drone flight plan with route segments",
  "type": "object",
  "required": ["uniqueProductIdentificationCode", "flightPlanList"],
  "properties": {
    "uniqueProductIdentificationCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "无人机唯一产品识别码 (UID)"
    },
    "flightPlanList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["flightPlanId", "planTakeoffTime", "planLandTime", "routeList"],
        "properties": {
          "flightPlanId": { "type": "integer", "minimum": 0 },
          "planTakeoffTime": { "type": "number", "minimum": 0 },
          "planLandTime": { "type": "number", "minimum": 0 },
          "flightTaskId": { "type": "integer", "minimum": 0 },
          "flightTaskName": { "type": "string", "maxLength": 256 },
          "routeList": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sequence", "type", "segmentStartLon", "segmentStartLat", "segmentEndLon", "segmentEndLat"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 0 },
                "type": { "type": "integer", "minimum": 1, "maximum": 3 },
                "segmentStartLon": { "type": "number", "minimum": -180, "maximum": 180 },
                "segmentStartLat": { "type": "number", "minimum": -90, "maximum": 90 },
                "segmentEndLon": { "type": "number", "minimum": -180, "maximum": 180 },
                "segmentEndLat": { "type": "number", "minimum": -90, "maximum": 90 },
                "segmentStartHeight": { "type": "number", "minimum": -500, "maximum": 20000 },
                "segmentEndHeight": { "type": "number", "minimum": -500, "maximum": 20000 },
                "segmentProtectHeight": { "type": "number", "minimum": 0, "maximum": 5000 },
                "segmentProtectHeightType": { "type": "integer", "minimum": 0, "maximum": 10 },
                "segmentWidth": { "type": "number", "minimum": 0, "maximum": 10000 }
              }
            }
          }
        }
      }
    }
  }
}
