<?xml version="1.0" ?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.4.1">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="13_操作日志查询场景" enabled="true">
      <stringProp name="TestPlan.comments">
【环境配置】
环境名称: SIT测试环境
协议: https
主机: dkkgsit-test.testdolphin.com
端口: 443
基础路径: /la-atc-biz-backend
描述: 系统集成测试环境，用于接口功能验证
【场景说明】
覆盖操作日志的查询、导出等操作
【覆盖接口】
1. POST /operation-log - 新增操作日志
2. GET /operation-log/5900498838306816 - 查看操作日志
3. GET /operation-log/count - 查询总数
4. GET /operation-log/export - 导出excel
5. GET /operation-log/page - 操作日志 page
【使用说明】
1. 修改用户定义变量中的 jwt-token 为有效的认证令牌
2. 可通过命令行参数覆盖环境变量，如: jmeter -Jhost=xxx -Jjwt-token=xxx
3. 执行前确保测试环境可访问
【生成时间】
2026-04-22 20:38:40
</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol</stringProp>
            <stringProp name="Argument.value">${__P(protocol,https)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="host" elementType="Argument">
            <stringProp name="Argument.name">host</stringProp>
            <stringProp name="Argument.value">${__P(host,dkkgsit-test.testdolphin.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,443)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="basePath" elementType="Argument">
            <stringProp name="Argument.name">basePath</stringProp>
            <stringProp name="Argument.value">${__P(basePath,/la-atc-biz-backend)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="jwt-token" elementType="Argument">
            <stringProp name="Argument.name">jwt-token</stringProp>
            <stringProp name="Argument.value">${__P(jwt-token,eyJhbGciOiJSUzI1NiJ9..XeDsbrfj0MiuaJuLKOV_ASjFAViE7kA9BVJ0Y8w47RsrLzUnnJGcl6f3OIP20MMyopa4tVxsfoviPgM_yyg8rw)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
