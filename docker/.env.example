# ATC/UTM 自动化测试平台 — 环境变量模板
# 使用方式：cp .env.example .env 并修改为实际值，然后 docker compose up -d
#
# 配置优先级：环境变量 > env.py 挂载文件 > 代码默认值

# ── 镜像版本 ─────────────────────────────────────────
TAG=latest

# ── 服务端口 ─────────────────────────────────────────
FLASK_PORT=5000

# ── 日志配置 ─────────────────────────────────────────
# UTM_LOG_FORMAT: simple=仅可读文本 | json=仅JSON | 留空=双输出
UTM_LOG_FORMAT=simple
# UTM_HTTP_LOG_LEVEL: WARNING=抑制请求日志 | INFO=显示所有请求
UTM_HTTP_LOG_LEVEL=WARNING
# UTM_VERBOSE: 1=恢复详细日志（数据库操作/Kafka发送等）
UTM_VERBOSE=0

# ── Redis 连接（必填）───────────────────────────────
UTM_REDIS_HOST=dolphin-test.kedacom.com
UTM_REDIS_PORT=21003
UTM_REDIS_PASSWORD=your_redis_password_here

# ── Redis A/B 双集群（可选，用于多集群部署）─────────
# UTM_REDIS_A_HOST=10.165.26.119
# UTM_REDIS_A_PORT=26379
# UTM_REDIS_A_PASSWORD=
# UTM_REDIS_B_HOST=10.165.26.139
# UTM_REDIS_B_PORT=26379
# UTM_REDIS_B_PASSWORD=

# ── Kafka 连接（必填）────────────────────────────────
UTM_KAFKA_URL=10.165.19.213:30011
# 双集群镜像写入（可选，留空禁用）
UTM_KAFKA_URL2=

# ── Kafka A/B 节点（可选）────────────────────────────
# UTM_KAFKA_A_URL=10.165.26.119:39092
# UTM_KAFKA_B_URL=10.165.26.139:39092

# ── MySQL 持久化（可选，留空则仅写 SQLite）───────────
UTM_MYSQL_HOST=10.165.32.147
UTM_MYSQL_PORT=3306
UTM_MYSQL_USER=utm
UTM_MYSQL_PASSWORD=your_mysql_password_here
UTM_MYSQL_DB=utm_simulator

# ── 达梦数据库（ATC 外部系统，只读）──────────────────
UTM_DM_HOST=10.165.32.212
UTM_DM_PORT=5236
UTM_DM_USER=SYSDBA
UTM_DM_PASSWORD=your_dameng_password_here
UTM_DM_SCHEMA=ATC_DKWRJ

# ── 达梦 B 集群（可选）───────────────────────────────
# UTM_DM_B_HOST=10.165.32.205
# UTM_DM_B_PORT=5236
# UTM_DM_B_USER=SYSDBA
# UTM_DM_B_PASSWORD=
# UTM_DM_B_SCHEMA=ATC_DKWRJ

# ── ATC 集群（海豚 Dashboard 后端）───────────────────
UTM_ATC_BASE_URL=https://dkkgsit-test.testdolphin.com
# UTM_ATC_CLUSTER_API=https://10.165.26.246/dolphin-agent/cluster.txt
# UTM_ATC_VIP=10.165.26.246
# UTM_ATC_NODE_A=10.165.26.119
# UTM_ATC_NODE_B=10.165.26.139

# ── IOMP 海豚部署 A/B ────────────────────────────────
# UTM_IOMP_A_IP=10.165.26.119
# UTM_IOMP_A_PORT=8801
# UTM_IOMP_A_ACCESS_KEY=
# UTM_IOMP_B_IP=10.165.26.139
# UTM_IOMP_B_PORT=8801
# UTM_IOMP_B_ACCESS_KEY=

# ── DOPS 海豚运维 ────────────────────────────────────
# UTM_DOPS_A_URL=https://10.165.26.119/dops
# UTM_DOPS_B_URL=https://10.165.26.139/dops

# ── ElasticSearch ────────────────────────────────────
# UTM_ES_HOSTS=10.165.26.119:29200,10.165.26.139:29200

# ── 文件路径（宿主机路径，用于数据持久化）───────────
# env.py 配置文件路径
ENV_PY_PATH=/opt/atc_test_platfrom/env.py
# JSON 数据文件存储路径
DATA_PATH=/opt/utm-simulator/data
# SQLite 数据库存储路径
DB_PATH=/opt/utm-simulator/db
# 应用日志存储路径
LOG_PATH=/opt/utm-simulator/logs
