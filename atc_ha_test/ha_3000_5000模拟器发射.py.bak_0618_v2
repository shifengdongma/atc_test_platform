# -*- coding: utf-8 -*-
"""
高可用3000平行模拟器发射（IDE 直接执行）

基于 3000平行模拟器发射.py 扩展：
- 同时向 A/B 两个 Kafka 集群发送数据（保证时间戳、UID 完全一致）
- 同时连接 A/B 两个 Redis 并批量写入航线
- 同时从 A/B 两个 Kafka 消费 uav_runtime_trace
- 性能优化：批量双写、并行连接初始化、减少序列化开销

用法：
    1. 直接在 IDE 中运行本脚本
    2. 命令行传参：python 高可用3000模拟器发射.py --interval 500 --no-consume-trace
"""
import os
import sys
import multiprocessing
import subprocess
import argparse
import time
import json
import threading
from typing import List, Dict, Any, Optional

# ── 路径配置（必须在第三方 import 之前执行）────────────────────────────
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
ENGINE_DIR = os.path.dirname(os.path.dirname(SCRIPT_DIR))
TOOLS_DIR = os.path.join(ENGINE_DIR, "tools")
PROJECT_ROOT = os.path.dirname(ENGINE_DIR)
GENERATOR_PY = os.path.join(TOOLS_DIR, "3000架平行飞行无人机轨迹点生成.py")

sys.path.insert(0, ENGINE_DIR)
sys.path.insert(0, TOOLS_DIR)

# ── 全部第三方导入集中在此 ────────────────────────────────────────────
import simulation_core as _sim_core
from uav_identifiers_extended import UAV_IDENTIFIERS_EXTENDED
from run_kafka_scene import UAVData
from kafka_proc import KafkaProducerClient, KafkaConsumerClient

try:
    import redis as _redis
except ImportError:
    _redis = None
# ========== Monkey Patch：扩展内置 ID 列表至 5000 个 ==========
_sim_core.UAV_IDENTIFIERS = UAV_IDENTIFIERS_EXTENDED
_sim_core.ACTIVE_UAV_IDENTIFIERS = UAV_IDENTIFIERS_EXTENDED
# =============================================================

# ── 默认参数（可在此修改）─────────────────────────────────────────────
DEFAULT_INTERVAL_MS = 1000      # 发射间隔（毫秒）
DEFAULT_LOOP = False            # 数据耗尽后是否循环
DEFAULT_CONSUME_TRACE = True    # 是否消费 uav_runtime_trace
ENABLE_REDIS_PREHEAT = True   # Redis预热开关，默认关闭

# IDE 直接运行配置：设为 True 时，无需命令行参数直接发射多场景数据
IDE_QUICK_RUN = True

# ── 场景文件分组（17个场景分3组并发发射，减少进程数）────────────────
# 进程1: 场景 01-06
# 进程2: 场景 07-11
# 进程3: 场景 12-17
_SCENE_GROUP_1 = [
    "ha_data_scene_01bj", "ha_data_scene_02tj", "ha_data_scene_03cz",
    "ha_data_scene_04dy", "ha_data_scene_05jn", "ha_data_scene_06yt",
]
_SCENE_GROUP_2 = [
    "ha_data_scene_07wh", "ha_data_scene_08qd", "ha_data_scene_09ly",
    "ha_data_scene_10sq", "ha_data_scene_11zz",
]
_SCENE_GROUP_3 = [
    "ha_data_scene_12zmd", "ha_data_scene_13bb", "ha_data_scene_14yc",
    "ha_data_scene_15nj", "ha_data_scene_16sz", "ha_data_scene_17sh",
]
_SCENE_GROUPS = [_SCENE_GROUP_1, _SCENE_GROUP_2, _SCENE_GROUP_3]

# 所有场景列表
IDE_SCENE_FILES = [
    os.path.join("mock", f"{name}.json")
    for name in _SCENE_GROUP_1 + _SCENE_GROUP_2 + _SCENE_GROUP_3
]

# 高可用环境配置导入（优先从当前脚本目录加载）
_HA_ENV_PATH = SCRIPT_DIR
if not os.path.isdir(_HA_ENV_PATH):
    _HA_ENV_PATH = os.path.join(PROJECT_ROOT, "高可用测试")
if _HA_ENV_PATH not in sys.path:
    sys.path.insert(0, _HA_ENV_PATH)
try:
    from ha_env import (
        kafka_url_a as _ha_kafka_a,
        kafka_url_b as _ha_kafka_b,
        redis_ip_a, redis_port_a, redis_password_a,
        redis_ip_b, redis_port_b, redis_password_b,
    )
    HA_ENV_AVAILABLE = True
except Exception as _e:
    print(f"[警告] 高可用环境配置加载失败，将使用本地默认配置: {_e}")
    HA_ENV_AVAILABLE = False
    _ha_kafka_a = None
    _ha_kafka_b = None

# ── 模块级常量（避免与函数参数名遮蔽）─────────────────────────────────
_KAFKA_URL_A = _ha_kafka_a if HA_ENV_AVAILABLE else "localhost:9092"
_KAFKA_URL_B = _ha_kafka_b if HA_ENV_AVAILABLE else None
_REDIS_A_CFG: Optional[Dict[str, Any]] = None
_REDIS_B_CFG: Optional[Dict[str, Any]] = None

if HA_ENV_AVAILABLE:
    _REDIS_A_CFG = {
        "host": redis_ip_a,
        "port": int(redis_port_a),
        "password": redis_password_a or None,
        "db": 0,
        "decode_responses": True,
    }
    _REDIS_B_CFG = {
        "host": redis_ip_b,
        "port": int(redis_port_b),
        "password": redis_password_b or None,
        "db": 0,
        "decode_responses": True,
    }



class HaSceneEmitter:
    """高可用场景 Kafka 发射器（双 Kafka + 双 Redis + 双 Trace）"""

    def __init__(
        self,
        files: Optional[List[str]] = None,
        scene_dir: Optional[str] = None,
        kafka_url_a: Optional[str] = None,
        kafka_url_b: Optional[str] = None,
        topic: str = "uav_runtime_data",
        interval_ms: int = 1000,
        timestamp_mode: str = "replace",
        loop: bool = False,
        debug_print_uav_ids: bool = False,
        consume_trace: bool = False,
        trace_group_id: Optional[str] = None,
        quiet: bool = False,
        enable_redis_preheat: bool = False,
    ):
        self.topic = topic
        self.interval_ms = interval_ms
        self.timestamp_mode = timestamp_mode
        self.loop = loop
        self.debug_print_uav_ids = debug_print_uav_ids
        self.consume_trace = consume_trace
        self.trace_group_id = trace_group_id or f"ha_scene_emitter_trace_{os.getpid()}"
        self.quiet = quiet
        self.enable_redis_preheat = enable_redis_preheat
        self.running = False

        # ── Kafka：使用 mirror 模式，一个客户端同时写 A/B 两个集群 ──
        _k_a = kafka_url_a or _KAFKA_URL_A
        _k_b = kafka_url_b or _KAFKA_URL_B
        self.kafka = KafkaProducerClient(
            _k_a,
            bootstrap_servers_mirror=_k_b if _k_b else None,
        )

        # ── 加载 UAV 数据（仅一次，保证 A/B 两侧 UID 完全一致） ──
        self.uav_data_list: List[UAVData] = []
        if files:
            self._load_from_files(files)
        if scene_dir:
            self._load_from_scene_dir(scene_dir)

        self._thread = None
        self._first_emit_time = None
        self._first_record_time = None

        # ── Redis A/B（并行连接） ──
        self.redis_a = None
        self.redis_b = None
        if _redis is not None:
            self._init_redis_parallel()

        # ── Trace Consumer A/B（并行初始化） ──
        self.trace_consumer_a = None
        self.trace_consumer_b = None
        self.trace_thread_a = None
        self.trace_thread_b = None
        self.trace_stats = {"received_a": 0, "received_b": 0}
        self.trace_records: List[Dict[str, Any]] = []
        if self.consume_trace:
            self._init_trace_consumers_parallel()

        self.stats = {
            "sent": 0,
            "start_time": None,
            "end_time": None,
        }

    # ── 并行初始化 Redis ──
    def _init_redis_parallel(self):
        def _connect(cfg, label, out_dict):
            try:
                client = _redis.Redis(**cfg)
                client.ping()
                if not self.quiet:
                    print(f"[Redis-{label}] 连接成功")
                out_dict[label] = client
            except Exception as e:
                if not self.quiet:
                    print(f"[Redis-{label}] 连接失败: {e}")
                out_dict[label] = None

        redis_a_cfg = _REDIS_A_CFG or {
            "host": "localhost",
            "port": 6379,
            "password": None,
            "db": 0,
            "decode_responses": True,
        }
        redis_b_cfg = _REDIS_B_CFG or {
            "host": "localhost",
            "port": 6379,
            "password": None,
            "db": 0,
            "decode_responses": True,
        }

        result: Dict[str, Any] = {}
        t_a = threading.Thread(target=_connect, args=(redis_a_cfg, "A", result))
        t_b = threading.Thread(target=_connect, args=(redis_b_cfg, "B", result))
        t_a.start()
        t_b.start()
        t_a.join()
        t_b.join()
        self.redis_a = result.get("A")
        self.redis_b = result.get("B")

    # ── 并行初始化 Trace Consumer ──
    def _init_trace_consumers_parallel(self):
        def _connect(url, label, out_dict):
            try:
                consumer = KafkaConsumerClient(
                    bootstrap_servers=url,
                    group_id=self.trace_group_id,
                    consume_from_latest_on_start=True,
                )
                consumer.subscribe(["uav_runtime_trace"])
                if not self.quiet:
                    print(f"[Trace-{label}] uav_runtime_trace 消费者已初始化 (group={self.trace_group_id})")
                out_dict[label] = consumer
            except Exception as e:
                if not self.quiet:
                    print(f"[Trace-{label}] 消费者初始化失败: {e}")
                out_dict[label] = None

        _k_a = _KAFKA_URL_A
        _k_b = _KAFKA_URL_B or _KAFKA_URL_A

        result: Dict[str, Any] = {}
        t_a = threading.Thread(target=_connect, args=(_k_a, "A", result))
        t_b = threading.Thread(target=_connect, args=(_k_b, "B", result))
        t_a.start()
        t_b.start()
        t_a.join()
        t_b.join()
        self.trace_consumer_a = result.get("A")
        self.trace_consumer_b = result.get("B")

    # ── 数据加载 ──
    def _load_from_files(self, files: List[str]):
        for path in files:
            if not os.path.exists(path):
                print(f"⚠️  文件不存在: {path}")
                continue
            self._load_json_file(path)

    def _load_from_scene_dir(self, scene_dir: str):
        if not os.path.exists(scene_dir):
            print(f"⚠️  场景目录不存在: {scene_dir}")
            return
        for fname in sorted(os.listdir(scene_dir)):
            if not fname.endswith(".json"):
                continue
            path = os.path.join(scene_dir, fname)
            self._load_json_file(path)

    def _load_json_file(self, path: str):
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, list):
                records = data
            elif isinstance(data, dict) and "records" in data:
                records = data["records"]
            else:
                records = [data]

            groups: Dict[str, List[Dict]] = {}
            for record in records:
                uid = record.get("uniqueProductIdentificationCode", "UNKNOWN")
                groups.setdefault(uid, []).append(record)

            for uid, uid_records in groups.items():
                self.uav_data_list.append(UAVData(uid, uid_records))
                print(f"  ✅ {uid}: {len(uid_records)} 条记录 ({os.path.basename(path)})")
        except Exception as e:
            print(f"  ❌ 加载失败 {path}: {e}")

    # ── 时间戳处理 ──
    def _process_timestamp(self, record: Dict, now_ms: int) -> int:
        original_ts = record.get("timestamp", 0)
        now_ms = now_ms - 1000  # 减 1 秒，可以慢不能快
        if self.timestamp_mode == "preserve":
            return original_ts
        elif self.timestamp_mode == "align":
            if self._first_emit_time is None:
                self._first_emit_time = now_ms
                self._first_record_time = original_ts
                return now_ms
            offset = original_ts - self._first_record_time
            return self._first_emit_time + offset
        else:
            return now_ms

    # ── 启动 / 停止 ──
    def start(self):
        if self.running:
            print("⚠️  发射器已在运行")
            return
        if not self.uav_data_list:
            print("❌ 没有加载到任何 UAV 数据")
            return

        self.running = True
        self.stats["start_time"] = time.time()

        self._thread = threading.Thread(target=self._emit_loop)
        self._thread.daemon = True
        self._thread.start()

        # 启动 trace 消费线程（A/B 双集群）
        if self.trace_consumer_a:
            self.trace_thread_a = threading.Thread(
                target=self._consume_trace_loop, args=(self.trace_consumer_a, "A")
            )
            self.trace_thread_a.daemon = True
            self.trace_thread_a.start()
        if self.trace_consumer_b:
            self.trace_thread_b = threading.Thread(
                target=self._consume_trace_loop, args=(self.trace_consumer_b, "B")
            )
            self.trace_thread_b.daemon = True
            self.trace_thread_b.start()

        # 发射前将航线写入 Redis（根据开关决定）
        if self.enable_redis_preheat and (self.redis_a or self.redis_b):
            print("\n[Redis] 正在写入 UAV 航线数据到 A/B 集群...")
            self._write_redis_route_batch_parallel()
            print(f"[Redis] 航线写入完成: {len(self.uav_data_list)} 架")
        elif not self.enable_redis_preheat:
            print("\n[Redis] 预热已关闭，跳过航线写入")

        print(f"\n🚀 高可用发射器启动")
        print(f"   UAV 数量: {len(self.uav_data_list)}")
        print(f"   Topic: {self.topic}")
        print(f"   间隔: {self.interval_ms}ms")
        print(f"   时间戳模式: {self.timestamp_mode}")
        if self.consume_trace:
            print(f"   Trace消费: 已启用 (A/B 双集群)")

    def stop(self):
        self.running = False
        if self._thread:
            self._thread.join(timeout=5)

        if self.trace_thread_a:
            self.trace_thread_a.join(timeout=3)
        if self.trace_thread_b:
            self.trace_thread_b.join(timeout=3)

        if self.trace_consumer_a:
            try:
                self.trace_consumer_a.close()
            except Exception:
                pass
        if self.trace_consumer_b:
            try:
                self.trace_consumer_b.close()
            except Exception:
                pass

        self.kafka.close()
        self.stats["end_time"] = time.time()

        # 保存 trace 数据到文件
        if self.consume_trace and self.trace_records:
            try:
                trace_path = os.path.join(ENGINE_DIR, "mock", "ha_redis_trace.json")
                os.makedirs(os.path.dirname(trace_path), exist_ok=True)
                with open(trace_path, "w", encoding="utf-8") as f:
                    json.dump(self.trace_records, f, ensure_ascii=False, indent=2)
                print(f"[Trace] 已保存 trace 数据到: {trace_path} ({len(self.trace_records)} 条)")
            except Exception as e:
                print(f"[Trace] 保存失败: {e}")
        elif not self.consume_trace and (self.redis_a or self.redis_b):
            # 未消费模式：直接扫描 Redis 查询 trace 数据
            try:
                trace_records = self._query_trace_from_redis()
                if trace_records:
                    trace_path = os.path.join(ENGINE_DIR, "mock", "ha_redis_trace.json")
                    os.makedirs(os.path.dirname(trace_path), exist_ok=True)
                    with open(trace_path, "w", encoding="utf-8") as f:
                        json.dump(trace_records, f, ensure_ascii=False, indent=2)
                    print(f"[Trace] 已查询并保存 Redis trace 数据: {trace_path} ({len(trace_records)} 条)")
                else:
                    print("[Trace] Redis 中未找到 trace 数据")
            except Exception as e:
                print(f"[Trace] 查询保存失败: {e}")

        print("🛑 发射器已停止")
        print(f"   共发送: {self.stats['sent']} 条")
        if self.consume_trace:
            print(f"   共接收trace-A: {self.trace_stats['received_a']} 条")
            print(f"   共接收trace-B: {self.trace_stats['received_b']} 条")

    # ── 发射循环 ──
    def _emit_loop(self):
        while self.running:
            t0 = time.perf_counter()
            if self._is_all_completed():
                if self.loop:
                    self._reset_all()
                else:
                    print("\n🏁 所有 UAV 数据已耗尽")
                    self.running = False
                    break
            self._emit_once()
            elapsed = (time.perf_counter() - t0) * 1000
            sleep_ms = max(0, self.interval_ms - elapsed)
            time.sleep(sleep_ms / 1000)

    def _emit_once(self):
        """单次发射：生成 records 后通过 KafkaProducerClient(mirror) 同时发往 A/B"""
        records = []
        now_ms = int(time.time() * 1000)

        for uav in self.uav_data_list:
            if not uav.has_next():
                continue
            record = uav.next()
            record["timestamp"] = self._process_timestamp(record, now_ms)
            records.append(record)

        if records:
            try:
                # KafkaProducerClient 内部会自动同时发往主集群和 mirror 集群
                self.kafka.send_bulk(records, self.topic)
                self.stats["sent"] += len(records)

                if not self.quiet:
                    progress = self._get_progress()
                    ts = int(time.time())
                    if self.debug_print_uav_ids:
                        uids = [r.get("uniqueProductIdentificationCode") for r in records]
                        print(f"[HA][uav_runtime_data]: {ts} 发送 {len(records)} 条 | {progress} | UAVs: {uids}")
                    else:
                        print(f"[HA][uav_runtime_data]: {ts} 发送 {len(records)} 条 | {progress}")
            except Exception as e:
                print(f"❌ HA 发送失败: {e}")

    def _is_all_completed(self) -> bool:
        return all(not u.has_next() for u in self.uav_data_list)

    def _reset_all(self):
        for uav in self.uav_data_list:
            uav.reset()
        self._first_emit_time = None
        self._first_record_time = None
        print("🔄 循环模式: 重新开始")

    def _get_progress(self) -> str:
        total = sum(u.total for u in self.uav_data_list)
        sent = sum(u.cursor for u in self.uav_data_list)
        return f"进度: {sent}/{total} ({sent / total * 100:.1f}%)"

    # ── Redis 航线双写（并行） ──
    def _write_redis_route_batch_parallel(self, batch_size=200, max_retries=3):
        if not self.redis_a and not self.redis_b:
            return

        def _write_single(client, label):
            if not client:
                return
            failed = []
            for retry in range(max_retries):
                if retry > 0 and not self.quiet:
                    print(f"[Redis-{label}] 第 {retry + 1} 次重试，待写入 {len(failed)} 架...")
                pipeline = client.pipeline(transaction=False)
                current_batch = []
                uavs_to_write = failed if retry > 0 else self.uav_data_list
                failed = []
                for uav in uavs_to_write:
                    route_data = self._build_redis_route(uav)
                    if route_data is None:
                        continue
                    pipeline.hset(
                        "BIZ_DATA:UAV_ROUTE",
                        uav.uid,
                        json.dumps(route_data, ensure_ascii=False),
                    )
                    current_batch.append(uav.uid)
                    if len(current_batch) >= batch_size:
                        try:
                            pipeline.execute()
                        except Exception as e:
                            if not self.quiet:
                                print(f"[Redis-{label}] 批量写入失败: {e}")
                            failed.extend(current_batch)
                        pipeline = client.pipeline(transaction=False)
                        current_batch = []
                if current_batch:
                    try:
                        pipeline.execute()
                    except Exception as e:
                        if not self.quiet:
                            print(f"[Redis-{label}] 批量写入失败: {e}")
                        failed.extend(current_batch)
                if not failed:
                    break
            if failed and not self.quiet:
                print(f"[Redis-{label}] ⚠️ 最终仍有 {len(failed)} 架写入失败")
            elif not self.quiet:
                print(f"[Redis-{label}] ✅ 全部 {len(self.uav_data_list)} 架航线写入成功")

        t_a = threading.Thread(target=_write_single, args=(self.redis_a, "A")) if self.redis_a else None
        t_b = threading.Thread(target=_write_single, args=(self.redis_b, "B")) if self.redis_b else None
        if t_a:
            t_a.start()
        if t_b:
            t_b.start()
        if t_a:
            t_a.join()
        if t_b:
            t_b.join()

    def _build_redis_route(self, uav):
        """根据 UAV 遥测数据生成航线字典（新格式）
        
        航段密度控制：每10个轨迹点生成1个航段，与原始脚本航点数量保持一致
        避免航段过于密集导致算法校验异常
        """
        if not uav.records or len(uav.records) < 2:
            return None
        records = uav.records
        route_list = []
        # 每10个轨迹点生成1个航段（避免航段过于密集）
        # 120个轨迹点 → 约12个航段，与原始脚本航点数量接近
        step = 10
        seq = 1
        for i in range(0, len(records) - 1, step):
            p0 = records[i]
            p1 = records[i + 1] if i + 1 < len(records) else records[-1]
            route_list.append({
                "sequence": seq,
                "type": 2,
                "segmentStartLon": p0.get("longitude", 0),
                "segmentStartLat": p0.get("latitude", 0),
                "segmentEndLon": p1.get("longitude", 0),
                "segmentEndLat": p1.get("latitude", 0),
                "segmentStartHeight": float(p0.get("geodeticAltitude", 0)),
                "segmentEndHeight": float(p1.get("geodeticAltitude", 0)),
                "segmentProtectHeight": 100.0,
                "segmentProtectHeightType": 1,
                "segmentWidth": 1000.0,
                "areaPolygon": None,
            })
            seq += 1
        start_ts = records[0].get("timestamp", int(time.time()))
        end_ts = records[-1].get("timestamp", start_ts + 600)
        if start_ts > 1e10:
            start_ts = int(start_ts / 1000.0)
        else:
            start_ts = int(start_ts)
        if end_ts > 1e10:
            end_ts = int(end_ts / 1000.0)
        else:
            end_ts = int(end_ts)
        # 使用固定值，与原始脚本 create_data.py 保持一致
        flight_plan = {
            "flightPlanId": 1,
            "planTakeoffTime": start_ts,
            "planLandTime": end_ts,
            "flightTaskId": 1,
            "flightTaskName": "test",
            "routeList": route_list,
        }
        return {
            "uniqueProductIdentificationCode": uav.uid,
            "uavType": "LARGE",
            "operateType": None,
            "flightPlanList": [flight_plan],
            "currentFlightPlan": flight_plan,
        }

    # ── Redis 通用读取 ──
    def _redis_get(self, client, key):
        """从 Redis 读取指定 key 的值，自动判断类型"""
        if not client:
            return None
        try:
            key_type = client.type(key)
            if key_type == "string":
                raw = client.get(key)
                if raw is None:
                    return None
                try:
                    return json.loads(raw)
                except json.JSONDecodeError:
                    return raw
            elif key_type == "hash":
                data = client.hgetall(key)
                if not data:
                    return None
                parsed = {}
                for k, v in data.items():
                    try:
                        parsed[k] = json.loads(v)
                    except json.JSONDecodeError:
                        parsed[k] = v
                return parsed
            elif key_type == "list":
                data = client.lrange(key, 0, -1)
                if not data:
                    return None
                parsed = []
                for item in data:
                    try:
                        parsed.append(json.loads(item))
                    except json.JSONDecodeError:
                        parsed.append(item)
                return parsed
            elif key_type == "set":
                data = list(client.smembers(key))
                parsed = []
                for item in data:
                    try:
                        parsed.append(json.loads(item))
                    except json.JSONDecodeError:
                        parsed.append(item)
                return parsed
            elif key_type == "zset":
                data = client.zrange(key, 0, -1, withscores=False)
                parsed = []
                for item in data:
                    try:
                        parsed.append(json.loads(item))
                    except json.JSONDecodeError:
                        parsed.append(item)
                return parsed
            else:
                return None
        except Exception as e:
            print(f"[Redis] 读取失败 {key}: {e}")
            return None

    def _query_trace_from_redis(self):
        """直接扫描 Redis 查询 trace 数据（优先 A，A 失败 fallback 到 B）"""
        for label, client in (("A", self.redis_a), ("B", self.redis_b)):
            if not client:
                continue
            records = []
            try:
                keys = list(client.scan_iter(match="uav_runtime_trace*", count=1000))
                for key in sorted(keys):
                    value = self._redis_get(client, key)
                    if value is not None:
                        records.append({"redisKey": key, "data": value, "source": label})
                if records:
                    return records
            except Exception as e:
                print(f"[Trace] 扫描 Redis-{label} uav_runtime_trace* 失败: {e}")
        return []

    # ── Trace 消费循环 ──
    def _consume_trace_loop(self, consumer, label):
        while self.running:
            try:
                messages = consumer.poll(timeout_ms=500)
                for msg in messages:
                    if not isinstance(msg, dict):
                        continue

                    ts = msg.get("timestamp", 0)
                    redis_key = msg.get("redisKey") or msg.get("redis_key")
                    self.trace_stats[f"received_{label.lower()}"] += 1

                    trace_data = None
                    data_count = 0

                    # 优先回查本侧 Redis
                    redis_client = self.redis_a if label == "A" else self.redis_b
                    if redis_key and redis_client:
                        try:
                            trace_data = self._redis_get(redis_client, redis_key)
                            if trace_data is None:
                                key_exists = redis_client.exists(redis_key)
                                key_type = redis_client.type(redis_key)
                                print(f"[Trace-{label}] Redis回查为空: key={redis_key}, exists={key_exists}, type={key_type}")
                        except Exception as e:
                            print(f"[Trace-{label}] Redis回查失败: {e}")
                        data_count = len(trace_data) if isinstance(trace_data, list) else (1 if trace_data else 0)
                    else:
                        msg_copy = dict(msg)
                        msg_copy.pop("timestamp", None)
                        if msg_copy:
                            trace_data = msg_copy
                            data_count = 1

                    if trace_data:
                        self.trace_records.append({
                            "timestamp": ts,
                            "redisKey": redis_key,
                            "data": trace_data,
                            "source": label,
                        })

                    print(f"\033[32m[uav_runtime_trace-{label}] {int(ts)} 收到 {data_count} 条\033[0m")
            except Exception as e:
                print(f"[Trace-{label}] 消费异常: {e}")
            time.sleep(0.05)

    def is_running(self) -> bool:
        return self.running

    def wait_until_done(self):
        try:
            while self.running:
                time.sleep(0.5)
        except KeyboardInterrupt:
            pass


def step1_generate_data():
    """步骤1：检查并生成数据文件。若缺失则自动调用生成脚本。"""
    json_files = [os.path.join(ENGINE_DIR, f) for f in IDE_SCENE_FILES]
    missing = [f for f in json_files if not os.path.isfile(f)]

    if not missing:
        print(f"[步骤1/2] 所有数据文件已存在，跳过生成")
        return json_files

    print("=" * 70)
    print("步骤 1/2：数据文件缺失，自动调用生成脚本")
    print("=" * 70)
    if not os.path.isfile(GENERATOR_PY):
        print(f"[错误] 找不到生成脚本: {GENERATOR_PY}")
        sys.exit(1)

    try:
        result = subprocess.run(
            [sys.executable, GENERATOR_PY],
            cwd=ENGINE_DIR,
            check=True,
            capture_output=True,
            text=True,
        )
        print(result.stdout)
    except subprocess.CalledProcessError as e:
        print(f"[错误] 数据生成失败:\n{e.stdout}\n{e.stderr}")
        sys.exit(1)

    still_missing = [f for f in json_files if not os.path.isfile(f)]
    if still_missing:
        print(f"[错误] 生成后仍缺少以下文件:")
        for f in still_missing:
            print(f"  - {f}")
        sys.exit(1)

    print(f"[完成] 数据生成完毕\n")
    return json_files


def _emit_worker(json_files, interval_ms, loop, consume_trace, quiet=False, trace_group_id=None, enable_redis_preheat=False):
    scene_names = [os.path.basename(f) for f in json_files]
    scene_name = ", ".join(scene_names[:3])
    if len(scene_names) > 3:
        scene_name += f"... (+{len(scene_names)-3})"
    try:
        emitter = HaSceneEmitter(
            files=json_files,
            interval_ms=interval_ms,
            loop=loop,
            consume_trace=consume_trace,
            trace_group_id=trace_group_id,
            quiet=quiet,
            enable_redis_preheat=enable_redis_preheat,
        )
        print(f"[{scene_name}] 高可用发射器初始化完成，UAV数量: {len(emitter.uav_data_list)}")
        emitter.start()
        try:
            emitter.wait_until_done()
        except KeyboardInterrupt:
            pass
        finally:
            try:
                if emitter.is_running():
                    emitter.stop()
            except KeyboardInterrupt:
                pass
    except Exception as e:
        print(f"[{scene_name}] 发射异常: {e}")
    finally:
        print(f"[{scene_name}] 进程结束")


def step2_emit_parallel(json_files, interval_ms, loop, consume_trace, enable_redis_preheat=False):
    """步骤2：并发启动多个发射进程（按分组）"""
    print("=" * 70)
    print("步骤 2/2：并发启动高可用发射进程 (A/B 双集群)")
    print("=" * 70)
    for i, f in enumerate(json_files, 1):
        print(f"  场景{i}: {os.path.basename(f)}")
    print(f"  总场景数: {len(json_files)}")
    print(f"  发射间隔: {interval_ms}ms")
    print(f"  循环模式: {'开启' if loop else '关闭'}")
    print(f"  Redis预热: {'开启' if enable_redis_preheat else '关闭'}")
    print(f"  Trace消费: {'开启' if consume_trace else '关闭'} (A/B 双集群)")
    print("=" * 70)
    print()

    processes = []
    shared_trace_group = "ha_scene_emitter_trace_shared"
    
    # 按分组启动进程
    for group_idx, scene_names in enumerate(_SCENE_GROUPS):
        group_files = [os.path.join(ENGINE_DIR, "mock", f"{name}.json") for name in scene_names]
        
        # 只让第一个进程消费 trace，避免重复打印
        consume = consume_trace if group_idx == 0 else False
        
        p = multiprocessing.Process(
            target=_emit_worker,
            args=(group_files, interval_ms, loop, consume, True, 
                  shared_trace_group if consume else None, enable_redis_preheat),
        )
        p.start()
        processes.append((p, f"Group{group_idx+1}"))
        print(f"[启动] 发射进程: Group{group_idx+1} ({len(scene_names)}场景, pid={p.pid}, trace={'开启' if consume else '关闭'})")

    # 等待所有进程完成（或收到中断信号）
    try:
        for p, name in processes:
            p.join()
    except KeyboardInterrupt:
        print("\n[中断] 收到停止信号，正在终止所有进程...")
        _terminate_processes(processes)
        print("\n✨ 已强制停止")
        return

    print("\n✨ 所有场景高可用发射完成")


def _terminate_processes(processes):
    """终止所有残留进程"""
    for p, name in processes:
        if p.is_alive():
            try:
                p.terminate()
                p.join(timeout=5)
            except (Exception, KeyboardInterrupt):
                pass
            if p.is_alive():
                try:
                    p.kill()
                    p.join(timeout=3)
                except (Exception, KeyboardInterrupt):
                    pass
                print(f"  {name} (PID {p.pid}) 被强制终止")
            else:
                print(f"  {name} (PID {p.pid}) 已终止")


def main():
    parser = argparse.ArgumentParser(
        description="高可用3000平行模拟器发射（双Kafka + 双Redis + 双Trace）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--interval", type=int, default=DEFAULT_INTERVAL_MS, help="发射间隔(毫秒)")
    parser.add_argument("--loop", action="store_true", default=DEFAULT_LOOP, help="数据耗尽后循环")
    parser.add_argument("--consume-trace", action="store_true", default=DEFAULT_CONSUME_TRACE, help="消费uav_runtime_trace (A/B双集群)")
    parser.add_argument("--no-consume-trace", action="store_true", help="不消费uav_runtime_trace")
    parser.add_argument("--redis-preheat", action="store_true", default=ENABLE_REDIS_PREHEAT, help="开启Redis预热")
    parser.add_argument("--no-redis-preheat", action="store_true", help="关闭Redis预热")
    parser.add_argument("--generate-only", action="store_true", help="仅生成数据，不发射")
    parser.add_argument("--emit-only", action="store_true", help="跳过生成，直接发射")
    args = parser.parse_args()

    consume_trace = not args.no_consume_trace if args.no_consume_trace else args.consume_trace
    enable_redis_preheat = args.redis_preheat if not args.no_redis_preheat else False

    if IDE_QUICK_RUN and not args.generate_only:
        # 步骤1：数据生成（若缺失）
        if not args.emit_only:
            json_files = step1_generate_data()
        else:
            json_files = [os.path.join(ENGINE_DIR, f) for f in IDE_SCENE_FILES]
            missing = [f for f in json_files if not os.path.isfile(f)]
            if missing:
                print(f"[错误] 找不到以下数据文件（请先用 --generate-only 生成）:")
                for f in missing:
                    print(f"  - {f}")
                sys.exit(1)

        if args.generate_only:
            print("\n[完成] 数据生成完毕，--generate-only 模式下跳过发射")
            return

        # 步骤2：并发发射
        step2_emit_parallel(json_files, args.interval, args.loop, consume_trace, enable_redis_preheat)
        return

    # 单文件模式
    JSON_PATH = os.path.join(ENGINE_DIR, "mock", "kafka_data_parallel.json")
    if not os.path.isfile(JSON_PATH):
        print(f"[错误] 找不到数据文件: {JSON_PATH}")
        print("请先生成数据: python tools\\3000架平行飞行无人机轨迹点生成.py")
        sys.exit(1)

    print("=" * 60)
    print("  高可用3000平行模拟器发射（单文件模式）")
    print(f"  数据文件: {JSON_PATH}")
    print(f"  发射间隔: {args.interval}ms")
    print("=" * 60)
    print()

    emitter = HaSceneEmitter(
        files=[JSON_PATH],
        interval_ms=args.interval,
        loop=args.loop,
        consume_trace=consume_trace,
    )
    emitter.start()
    try:
        emitter.wait_until_done()
    except KeyboardInterrupt:
        print("\n[中断] 收到停止信号")
    finally:
        if emitter.is_running():
            emitter.stop()
    print("\n✨ 程序结束")


if __name__ == "__main__":
    main()
