{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utm-simulator/schemas/telemetry_schema.json",
  "title": "UTM Telemetry Message Schema",
  "description": "Kafka uav_runtime_data topic message schema — real-time drone telemetry data",
  "type": "object",
  "required": ["uniqueProductIdentificationCode", "longitude", "latitude", "geodeticAltitude", "operatingStatus", "timestamp"],
  "properties": {
    "uniqueProductIdentificationCode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "realNameRegistrationSign": { "type": "string", "maxLength": 128 },
    "uasOperationCategory": { "type": "integer", "minimum": 1, "maximum": 2 },
    "classification": { "type": "integer", "minimum": 1, "maximum": 5 },
    "rpsLocationType": { "type": "integer", "minimum": 0, "maximum": 10 },
    "rpsLongitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "rpsLatitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "rpsAltitude": { "type": "number", "minimum": -500, "maximum": 20000 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "trackAngle": { "type": "number", "minimum": 0, "maximum": 360 },
    "speed": { "type": "number", "minimum": 0, "maximum": 500 },
    "geodeticAltitude": { "type": "number", "minimum": -500, "maximum": 20000 },
    "verticalSpeed": { "type": "number", "minimum": -100, "maximum": 100 },
    "relativeAltitude": { "type": "number", "minimum": -500, "maximum": 20000 },
    "ressureAltitude": { "type": "number", "minimum": -500, "maximum": 20000 },
    "operatingStatus": { "type": "integer", "minimum": 0, "maximum": 5 },
    "coordinateSystemType": { "type": "integer", "minimum": 0, "maximum": 10 },
    "horizontalAccuracy": { "type": "number", "minimum": 0, "maximum": 1000 },
    "verticalAccuracy": { "type": "number", "minimum": 0, "maximum": 1000 },
    "speedAccuracy": { "type": "number", "minimum": 0, "maximum": 100 },
    "timestamp": { "type": "number", "minimum": 0 },
    "timestampAccuracy": { "type": "integer", "minimum": 0 },
    "sourceType": { "type": "integer", "minimum": 1, "maximum": 2 },
    "active": { "type": "integer", "minimum": 0, "maximum": 1 },
    "addInf": { "type": "object" }
  }
}
