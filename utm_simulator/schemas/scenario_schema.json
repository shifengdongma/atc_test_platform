{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utm-simulator/schemas/scenario_schema.json",
  "title": "UTM Scenario File Schema",
  "description": "Scenario JSON file schema (mock/kafka_data.json) — flight mission template with UAV list and plan template",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "type": { "type": "string", "maxLength": 64 },
        "default_drone_count": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    },
    "task": {
      "type": "object",
      "properties": {
        "taskName": { "type": "string" },
        "taskPurpose": { "type": "string" },
        "taskType": { "type": "string" },
        "taskDescription": { "type": "string" }
      }
    },
    "uasList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uniqueProductIdentificationCode"],
        "properties": {
          "uniqueProductIdentificationCode": { "type": "string", "minLength": 1 },
          "realNameRegistrationSign": { "type": "string" }
        }
      }
    },
    "planTemplate": {
      "type": "object",
      "properties": {
        "flightPlanList": { "type": "array", "minItems": 1 }
      }
    }
  }
}
